  "findings": [
    {"id": "k4-blocking", "status": "static_verified", "sources": ["k4-player"], "summary_zh": "等待播放取得 thread lock，通过结束、停止或错误回调释放，不是固定时长积木。"},
    {"id": "k4-overlap", "status": "static_verified", "sources": ["k4-player", "k4-vendor"], "summary_zh": "共享资源 Howl 的无 ID play 不先停止旧播放；活跃播放不被当作空闲 Sound，允许重叠。"},
    {"id": "k4-resource-properties", "status": "static_verified", "sources": ["k4-player", "k4-vendor"], "summary_zh": "音量及速率按资源共享；积木百分数除以100，volume夹到[0,1]，rate夹到[0.05,4]，运行清理恢复项目初值。"},
    {"id": "kn-web-overlap", "status": "static_verified_not_runtime_tested", "sources": ["kn-main", "kn-vendor"], "summary_zh": "Web core 每次新建 Howl 并遍历同 ID 既有 Howl 调用 play，非 restart；存在数量保护及共享注册表清理边缘行为。"},
    {"id": "kn-web-stop-end", "status": "static_verified_not_runtime_tested", "sources": ["kn-main"], "summary_zh": "Web onstop 回报 PLAY_END、progress 0，onend 回报 PLAY_END、progress 1；等待版监听 PLAY_END/FAIL/TIMEOUT。"},
    {"id": "kn-stop-all-token", "status": "static_verified", "sources": ["kn-main"], "value": "all_audio", "summary_zh": "domain 比较 le.si；46501内 le 依赖90667，si导出I，I为all_audio。"},
    {"id": "kn-tts-global", "status": "static_verified", "sources": ["kn-main"], "summary_zh": "soundColor mutation配置全局TTS singleton；spd/pit/vol先夹[5,20]再减5；在线TTS服务读取该配置；普通音频积木未传这些属性。"},
    {"id": "clone-private-volume", "status": "unsupported_by_audited_official_evidence", "sources": ["k4-player", "k4-vendor", "kn-main"], "summary_zh": "未发现克隆独立音量依据；K4资源共享，KN普通音频入口无音量参数，TTS配置全局。不可声明已证明官方克隆独立。"}
  ],
