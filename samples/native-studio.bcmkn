        "comments": {},
        "nekoBlockJsonList": [{
          "id": "start", "type": "on_running_group_activated", "parent_id": null,
          "next": {
            "id": "color", "type": "self_set_pen_color", "parent_id": "start", "fields": {"color": "#608fee"},
            "next": {
              "id": "size", "type": "self_set_pen_size", "parent_id": "color",
              "inputs": { "size": { "id": "size-n", "type": "math_number", "parent_id": "size", "fields": {"NUM": 4} } },
              "next": {
                "id": "down", "type": "self_pen_down", "parent_id": "size",
                "next": {
                  "id": "repeat", "type": "repeat_n_times", "parent_id": "down",
                  "inputs": { "times": { "id": "times-n", "type": "math_number", "parent_id": "repeat", "fields": {"NUM": 15} } },
                  "statements": {
                    "DO": {
                      "id": "move", "type": "self_go_forward", "parent_id": "repeat",
                      "inputs": { "steps": { "id": "steps-n", "type": "math_number", "parent_id": "move", "fields": {"NUM": 40} } },
                      "next": {
                        "id": "turn", "type": "self_rotate", "parent_id": "move",
                        "inputs": { "degrees": { "id": "degrees-n", "type": "math_number", "parent_id": "turn", "fields": {"NUM": 24} } }
                      }
                    }
                  },
                  "next": {
                    "id": "up", "type": "self_pen_up", "parent_id": "repeat",
                    "next": {
                      "id": "log", "type": "console_log", "parent_id": "up",
                      "inputs": { "console_log": { "id": "log-text", "type": "text", "parent_id": "log", "fields": {"TEXT": "Drawn entirely by the Rust runtime."} } }
                    }
                  }
                }
              }
            }
          }
        }]
      }
