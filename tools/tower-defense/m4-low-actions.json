{
  "before": [
    {
      "name": "enter",
      "key": "Enter",
      "domKey": true,
      "waitMs": 300,
      "assert": {
        "mode": 1
      }
    },
    {
      "name": "sector6",
      "key": "6",
      "domKey": true,
      "waitMs": 300,
      "assert": {
        "mode": 2,
        "level": 6
      }
    },
    {
      "name": "showcase-fixture-only",
      "set": {
        "gold": 5000,
        "wave": 9
      },
      "waitMs": 200
