    {
      "name": "manual-low",
      "key": "q",
      "domKey": true,
      "waitMs": 300,
      "assert": {
        "quality": 0
      }
    },
    {
      "name": "pulse",
      "click": {
        "x": -330,
        "y": 165
      },
      "waitMs": 250
    },
    {
      "name": "pulse-up-2",
      "key": "u",
      "domKey": true,
      "waitMs": 250
    },
    {
      "name": "pulse-up-3",
      "key": "u",
      "domKey": true,
      "waitMs": 250,
      "assertLists": {
        "tLevel": {
          "0": 3
        }
      }
    },
    {
      "key": "2",
      "domKey": true,
      "waitMs": 150
    },
    {
      "name": "frost",
      "click": {
        "x": -160,
        "y": 175
      },
      "waitMs": 250
    },
    {
      "key": "u",
      "domKey": true,
      "waitMs": 200
    },
    {
      "key": "u",
      "domKey": true,
      "waitMs": 200,
      "assertLists": {
        "tLevel": {
          "4": 3
        }
      }
    },
    {
      "key": "3",
      "domKey": true,
      "waitMs": 150
    },
    {
      "name": "nova",
      "click": {
        "x": 15,
        "y": 55
      },
      "waitMs": 250
    },
    {
      "key": "u",
      "domKey": true,
      "waitMs": 200
    },
    {
      "key": "u",
      "domKey": true,
      "waitMs": 200,
      "assertLists": {
        "tLevel": {
          "5": 3
        }
      }
    },
    {
      "key": "4",
      "domKey": true,
      "waitMs": 150
    },
    {
      "name": "prism",
      "click": {
        "x": 180,
        "y": 55
      },
      "waitMs": 250
    },
    {
      "key": "u",
      "domKey": true,
      "waitMs": 200
    },
    {
      "key": "u",
      "domKey": true,
      "waitMs": 200,
