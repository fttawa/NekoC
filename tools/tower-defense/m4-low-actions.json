          "0": 1,
          "4": 2,
          "5": 3,
          "7": 4
        },
        "tLevel": {
          "7": 3
        }
      }
    },
    {
      "name": "mixed-final-wave",
      "key": "Space",
      "domKey": true,
      "waitMs": 1500,
      "until": {
        "name": "spawnIndex",
        "op": "gt",
        "value": 10
      },
      "assert": {
        "wave": 10,
        "mode": 2
      }
    }
