  "benchmark": {
    "label": "M4 manual low, same stress setup as high",
    "windows": 3,
    "windowMs": 4000,
    "assert": {
      "mode": 2,
      "paused": 0
    },
    "activeEnemies": true,
    "validateActorLayers": true
  },
  "after": [
    {
      "name": "boss-introduction",
      "until": {
        "name": "bossAlert",
        "op": "gt",
        "value": 0
      },
      "timeout": 20000
    }
